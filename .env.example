# Sessions / flash. Local dev: any string. Production: openssl rand -hex 32
# On Render using this repo’s render.yaml, SECRET_KEY is created via generateValue.
SECRET_KEY=dev-secret-change-me

# Site branding (optional overrides; defaults show Novel Prep on all pages).
# SITE_BRAND_NAME=Novel Prep Math Studio
# SITE_BRAND_SHORT=Novel Prep
# SITE_LOGIN_KICKER=Novel Prep · SAT Math Studio
# SITE_TEACHER_LABEL=Novel Prep
# SITE_SUPPORT_CONTACT=Novel Prep

# Optional: Render API key for scripts/render_ops.sh (delete duplicate service, trigger deploy).
# RENDER_API_KEY=rnd_...

# Optional: SQLite path. Use an absolute path on a persistent volume when hosting
# (e.g. Render disk mount). If unset, uses sat.db beside the app.
# DB_PATH=/var/data/sat.db

# Desmos graphing calculator embed (practice question side panel).
# Get a key at https://www.desmos.com/my-api
DESMOS_API_KEY=

# Optional: pack-backed Repair this skill. Default off. Not required for ordinary Practice/Analytics.
# If unset, SKILL_LOOP_PILOT can also enable Repair. Explicit SKILL_REPAIR=false wins.
# SKILL_REPAIR=false
# SKILL_LOOP_PILOT=false
# When SKILL_LOOP_PILOT is on in production, set exactly one test username. Empty = nobody.
# Do not use user_id % 2 as an access gate.
# SKILL_LOOP_ALLOWLIST_USERNAMES=
