          "html": "<div class=\"cm-content-canvas\"><div class=\"cm-content-bg\" aria-hidden=\"true\"><span class=\"cm-content-orb cm-content-orb--1\"></span><span class=\"cm-content-orb cm-content-orb--2\"></span><span class=\"cm-content-grid\"></span></div><div class=\"cm-content-inner\"><span class=\"cm-content-kicker\">Lesson outline</span><p class=\"cm-content-unit\">Unit 1 · 1.2</p><h2 class=\"cm-content-title\">Defining limits</h2><p class=\"cm-content-lede\">5 sections · theory, examples, and AP-style checks.</p><ol class=\"cm-content-list\"><li><button type=\"button\" class=\"cm-content-item\" data-cm-jump-section=\"4\"><span class=\"cm-content-num\">01</span><span class=\"cm-content-copy\"><strong>Informal definition</strong><span>Jump to section</span></span><span class=\"cm-content-arrow\" aria-hidden=\"true\">→</span></button></li><li><button type=\"button\" class=\"cm-content-item\" data-cm-jump-section=\"8\"><span class=\"cm-content-num\">02</span><span class=\"cm-content-copy\"><strong>Piecewise example</strong><span>Jump to section</span></span><span class=\"cm-content-arrow\" aria-hidden=\"true\">→</span></button></li><li><button type=\"button\" class=\"cm-content-item\" data-cm-jump-section=\"12\"><span class=\"cm-content-num\">03</span><span class=\"cm-content-copy\"><strong>Graph reading</strong><span>Jump to section</span></span><span class=\"cm-content-arrow\" aria-hidden=\"true\">→</span></button></li><li><button type=\"button\" class=\"cm-content-item\" data-cm-jump-section=\"14\"><span class=\"cm-content-num\">04</span><span class=\"cm-content-copy\"><strong>AP MCQ</strong><span>Jump to section</span></span><span class=\"cm-content-arrow\" aria-hidden=\"true\">→</span></button></li><li><button type=\"button\" class=\"cm-content-item\" data-cm-jump-section=\"16\"><span class=\"cm-content-num\">05</span><span class=\"cm-content-copy\"><strong>Practice packet</strong><span>Jump to section</span></span><span class=\"cm-content-arrow\" aria-hidden=\"true\">→</span></button></li></ol></div></div>",
          "kind": "content",
          "group": "divider",
